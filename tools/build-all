#!/bin/bash

##
# Lazy wrapper script that will clean, build, and package the project
# using the existing .venv
##
TOOLS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT=$(dirname "${TOOLS_DIR}")

# Refuse to run if there isn't a venv
VENV=${PROJECT_ROOT}/.venv
if [ ! -f ${VENV}/bin/activate ]; then
    echo "Error: Virtual environment not found at ${VENV}"
    echo "Please create a virtual environment with minimum python version 3.11.0"
    echo "python3 -m venv .venv"
    exit 1
fi

source "${VENV}/bin/activate"

${TOOLS_DIR}/clean.py
${TOOLS_DIR}/build.py
${TOOLS_DIR}/package.py