#!/usr/bin/python3
"""Runs a single driver in a subprocess"""

import signal
from argparse import ArgumentParser

from driver import Futaba, utils

logger = utils.newLogger("start_script")

parser = ArgumentParser()

parser.add_argument(
    "--bus",
    dest="bus",
    type=str,
    help="Specify which bus the Futaba device is on",
)

parser.add_argument(
    "--port",
    dest="port",
    type=str,
    help="Specify which port the Futaba device is on",
)

parser.add_argument(
    "--use-name",
    dest="name",
    type=str,
    help="The name that you want to use for the process - optional",
)

args = parser.parse_args()


def main():
    """Creates the driver, sets up signal kill listeners and starts the driver"""

    ##
    # - Create the drvier
    # - create sigkill listeners to we can exit gracefully when requested
    # - start the driver (blocks indefinitely)
    ##
    try:
        driver = Futaba.FutabaDeviceDriver(bus=args.bus, port=args.port, name=args.name)

        # Set up sigkill listeners so we can exit gracefully
        signal.signal(signal.SIGINT, lambda _, __: driver.stop())
        signal.signal(signal.SIGTERM, lambda _, __: driver.stop())

        # Blocks the main thread - That's OK because this should be run as a subprocess anyway
        driver.start()
    except Exception as e:
        if driver is not None:
            driver.stop()
        raise e


if __name__ == "__main__":
    main()
