#!/usr/bin/python3
"""Runs a single driver in a subprocess"""

import signal
from argparse import ArgumentParser

import utils
from FutabaUsbDevice import PRODUCTS, T16IZ, WSC_1, FutabaUsbDevice

logger = utils.generateLogger("start_script")

parser = ArgumentParser()
parser.add_argument(
    "--bus",
    dest="bus",
    type=str,
    help="Specify which bus the Futaba device is on",
)

parser.add_argument(
    "--port",
    dest="port",
    type=str,
    help="Specify which port the Futaba device is on",
)

parser.add_argument(
    "--vendor-id",
    dest="vendorID",
    type=str,
    help="(optional) Specify the vendor id of the Futaba USB device you want to start a driver for",
)

parser.add_argument(
    "--product-id",
    dest="productID",
    type=str,
    help="Specify the product id of the Futaba USB device you want to start a driver for",
)

parser.add_argument(
    "--use-name",
    dest="name",
    type=str,
    help="The name that you want to use for the process - optional",
)

parser.add_argument(
    "--device-class",
    dest="deviceClass",
    type=str,
    help="The type of device. ie WSC-1, T16IZ, etc",
)

args = parser.parse_args()


def main():
    """Creates the driver, sets up signal kill listeners and starts the driver"""
    if args.deviceClass is None and args.productID is None:
        raise RuntimeError(
            "You must provide either a --device-class flag or a --product-id flag!"
        )

    try:
        utils.configSanityCheck()
        driver = None
        if args.deviceClass.upper() == "WSC-1" or args.productID == PRODUCTS["WSC-1"]:
            driver = WSC_1(
                bus=args.bus,
                port=args.port,
                name=args.name,
            )
        elif args.deviceClass.upper() == "T16IZ" or args.productID == PRODUCTS["T16IZ"]:
            driver = T16IZ(
                bus=args.bus,
                port=args.port,
                name=args.name,
            )
        else:
            logger.warning(
                f"There is no device class for product >{args.deviceClass.upper()}<"
            )
            if args.productID is None:
                raise RuntimeError(
                    f"productID was not provided and >{args.deviceClass.upper()}< does not yet have a class defined"
                )

            driver = FutabaUsbDevice(
                productID=args.productID,
                vendorID=args.vendorID,
                bus=args.bus,
                port=args.port,
                name=args.name,
            )

        # Set up sigkill listeners so we can exit gracefully
        signal.signal(signal.SIGINT, lambda _, __: driver.stop())
        signal.signal(signal.SIGTERM, lambda _, __: driver.stop())

        # Blocks the main thread - That's OK because this should be run as a subprocess anyway
        driver.start()
    except Exception as e:
        logger.error(e)
        if driver is not None:
            driver.stop()


if __name__ == "__main__":
    main()
