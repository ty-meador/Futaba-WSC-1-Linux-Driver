# Ignore all files in calibrations directory except those starting with underscore and ending in .json
# (users custom calibration files)
src/Futaba/calibrations/*
!src/Futaba/calibrations/_*.json

# Ignore all files in configs directory except those starting with underscore and ending in .json
# (users custom calibration files)
src/Futaba/configs/*
!src/Futaba/configs/_*.json