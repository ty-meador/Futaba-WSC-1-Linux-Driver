import multiprocessing
import usb
from . import DriverSubproc as DriverSubproc
from .IPC import WorkerControl as WorkerControl
from .InputChannel import InputChannel as InputChannel
from .__config__ import CALIBRATION_PATH as CALIBRATION_PATH, CONFIG_PATH as CONFIG_PATH, DEFAULT_CALIBRATION as DEFAULT_CALIBRATION, DEFAULT_CONFIG as DEFAULT_CONFIG, DeviceConfig as DeviceConfig, FUTABA_VENDOR_ID as FUTABA_VENDOR_ID
from _typeshed import Incomplete
from enum import Enum
from multiprocessing.connection import Connection

class DriverState(Enum):
    RUNNING = ...
    STOPPED = ...
    SUSPENDED = ...
    INITIALIZING = ...

class FutabaDeviceDriver:
    state: DriverState
    endpoint: int | None
    logger: Incomplete
    subProc: multiprocessing.Process | None
    workerCtl: WorkerControl
    channelEvents: tuple[str, ...]
    deadZone: int
    deviceUUID: str
    frameSize: int
    manufacturer: str
    noiseFilter: int
    pipe: Connection
    product: str
    productID: int
    speed: int | None
    serialNumber: str
    bus: int
    address: int
    name: str
    deviceChannels: Incomplete
    def __init__(self, device: usb.core.Device) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    def __del__(self) -> None: ...
    def disableEcho(self) -> None: ...
    def enableEcho(self) -> None: ...
    def getState(self) -> DriverState: ...
    def start(self) -> DriverState: ...
    def stop(self) -> None: ...
    def suspend(self) -> None: ...
    def toggleEcho(self) -> None: ...
    @staticmethod
    def deviceIsSupported(coreDevice: usb.core.Device) -> bool: ...
